!assets/*.svg
# Generated WASM artifacts (rebuild with the command in README > WebAssembly).
wasm/*.wasm
wasm/hikari_wasm.js
wasm/*.d.ts
# The playground bundle is a build artifact, not source. Committing a 2.7 MB
# binary means every release churns it and it silently goes stale against the
# font subset -- it was still carrying the pre-v0.18 layout-less font. The Pages
# workflow rebuilds it.
docs/playground/pkg/
npm/*.node
npm/og-node.png

# Demo artifacts: regenerated by `cargo run --example invoice|motion`.
invoice.pdf
motion.gif
# Rendered output shown in the docs site. These are real engine output, not
# design assets, so they are committed and diffable rather than ignored.
!docs/img/**
